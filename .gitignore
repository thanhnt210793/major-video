# Python TTS environment (recreate with the commands in CLAUDE.md)
.venv-tts/
__pycache__/

# Node
node_modules/

# Personal Claude Code settings (machine-specific paths)
.claude/settings.local.json

# Regenerable media and caches
assets/voice-samples/
# HyperFrames local workflow state: history and caches with this machine's absolute paths
videos/*/*/.hyperframes/
videos/*/*/snapshots/
content/*/*/qa/**/*.png
content/*/*/qa/**/*.jpg

# Renders are large binaries: keep them on disk or in external storage, not in git
videos/*/*/renders/

# Draft/preview audio (regenerable)
content/*/*/audio/**/*.wav
content/*/*/audio/**/*.mp4

# Mixed music beds: each video's tools/music-bed.mjs rebuilds them from assets/audio/music
videos/*/*/assets/bgm/
